{
  "name": "test-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "自动化测试 Agent UI 与框架原型",
  "scripts": {
    "dev": "pnpm --filter agent-web dev",
    "dev:agent": "pnpm --filter agent-web dev",
    "build:shared": "pnpm --filter @project/shared-api build",
    "build:agent": "pnpm --filter agent-web build",
    "build": "pnpm build:shared && pnpm build:agent",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @project/shared-api test && pnpm --filter test-agent-desktop test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,mjs,cjs,jsx,json,css,less}\" \"packages/**/*.{ts,tsx,js,mjs,cjs,json,css,less}\" \"*.{json,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,mjs,cjs,jsx,json,css,less}\" \"packages/**/*.{ts,tsx,js,mjs,cjs,json,css,less}\" \"*.{json,yaml}\"",
    "dev:desktop": "pnpm --filter test-agent-desktop dev",
    "desktop": "pnpm build:agent && pnpm --filter test-agent-desktop start",
    "package:mac": "pnpm build:agent && pnpm --filter test-agent-desktop package:mac",
    "package:win": "pnpm build:agent && pnpm --filter test-agent-desktop package:win"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@9.15.9"
}
