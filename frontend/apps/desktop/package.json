{
  "name": "test-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows / macOS 本地自动化测试 Agent 原型",
  "author": "Project Team",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "node scripts/run.mjs --dev",
    "start": "node scripts/run.mjs",
    "typecheck": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "local.testagent.desktop",
    "productName": "Test Agent",
    "asar": true,
    "directories": {
      "output": "../../../artifacts/desktop"
    },
    "files": [
      "src/**/*.{mjs,cjs}",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../agent-web/dist",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "html-to-text": "10.0.1",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299"
  }
}
